modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Konomi Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DB Grid Setup"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Verify Grid"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DB Initialization"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DB Population"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "DB Monitor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Test Connection Manager"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backup Test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "List Backups"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Directory Manager Tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Code Validator Tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Code Validator Demo"

[[workflows.workflow]]
name = "Konomi Server"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"
waitForPort = 5000

[[workflows.workflow]]
name = "DB Grid Setup"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python db_grid_setup.py"

[[workflows.workflow]]
name = "Verify Grid"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python verify_grid.py"

[[workflows.workflow]]
name = "DB Initialization"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python initialize_databases.py"

[[workflows.workflow]]
name = "DB Population"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python populate_databases.py"

[[workflows.workflow]]
name = "DB Monitor"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python db_monitor_service.py"

[[workflows.workflow]]
name = "Test Connection Manager"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m pytest tests/test_connection_manager.py -v"

[[workflows.workflow]]
name = "Backup Test"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python backup_cli.py backup"

[[workflows.workflow]]
name = "List Backups"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python backup_cli.py list"

[[workflows.workflow]]
name = "Directory Manager Tests"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m pytest tests/test_directory_manager.py -v"

[[workflows.workflow]]
name = "Code Validator Tests"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m pytest tests/test_code_validator.py -v"

[[workflows.workflow]]
name = "Code Validator Demo"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = """
python3 -c \"
from konomi.utils.code_validator import CodeValidator

# Test the validator with sample code
validator = CodeValidator()
test_code = '''
def insecure_function():
    api_key = 'secret123'
    eval(input('Enter code: '))
'''

results = validator.validate_code(test_code)
print('
Validation Results:')
print('=' * 20)
print(f'Valid: {results[\"valid\"]}')
print('Details:')
for category, details in results['details'].items():
    print(f'{category}:')
    for key, value in details.items():
        print(f'  - {key}: {value}')\"
"""

[deployment]
run = ["sh", "-c", "python main.py"]

[[ports]]
localPort = 5000
externalPort = 80
